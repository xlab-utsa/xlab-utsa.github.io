  "version": "0.1.0",
  "description": "Internal dev tool: interactive visualizer for the xlab-utsa.github.io content schema. Not part of the deployed site.",
  "type": "module",
  "scripts": {
    "predev": "node scripts/scan-content.mjs",
    "dev": "vite",
    "prebuild": "node scripts/scan-content.mjs",
